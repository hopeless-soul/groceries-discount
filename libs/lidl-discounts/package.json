{
  "name": "lidl-discounts",
  "version": "0.1.0",
  "description": "Unofficial TypeScript client for the public Lidl Plus store & offers endpoints (browser + Node compatible).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
